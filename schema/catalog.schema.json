{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/neoanki/extensions/main/schema/catalog.schema.json",
  "title": "NeoAnki extension catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "extensions"],
  "properties": {
    "$schema": { "const": "./schema/catalog.schema.json" },
    "format": { "const": "neo-anki-extension-catalog" },
    "schemaVersion": { "const": 1 },
    "extensions": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 500 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "maxLength": 64 },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "description", "publisher", "repository", "license", "categories", "tags", "release"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "publisher": {
          "type": "object", "additionalProperties": false, "required": ["name", "url"],
          "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 }, "url": { "$ref": "#/$defs/httpsUrl" } }
        },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$", "maxLength": 300 },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "license": { "type": "string", "minLength": 1, "maxLength": 64 },
        "categories": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["study", "authoring", "import-export", "planning", "analytics", "accessibility", "integration", "appearance"] } },
        "tags": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32 } },
        "release": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "publishedAt", "packageUrl", "sha256", "publisherKey", "minimumNeoAnkiVersion", "permissions"],
          "properties": {
            "version": { "$ref": "#/$defs/semver" },
            "publishedAt": { "type": "string", "format": "date-time" },
            "packageUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/[^/]+/[^/]+\\.neoanki-extension$", "maxLength": 500 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "publisherKey": { "type": "string", "minLength": 40, "maxLength": 4096 },
            "minimumNeoAnkiVersion": { "$ref": "#/$defs/semver" },
            "permissions": { "type": "array", "maxItems": 19, "uniqueItems": true, "items": { "enum": ["study:read", "study:signals", "study:prompt-types", "study:queue-policies", "content:read", "content:patch-own", "content:migrate", "media:create", "network:fetch", "secrets:device", "config:sync", "files:save", "ui:open-external", "ui:settings", "ui:review", "ui:page", "ui:create", "ui:workspace", "ui:migration"] } }
          }
        }
      }
    }
  }
}
